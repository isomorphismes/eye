"""Reproducible host qualification; no provisioning or backend substitution.

usage: ithon /absolute/eye/_/qualify.pi /absolute/Idric /absolute/ithon [--render]
SymPy 1.14.0 and mpmath 1.3.0 must already be importable by Ithon.
"""
import os
import sys
import subprocess
import shutil
import tempfile
from pathlib import Path
from builtins import RuntimeError, dict, repr

argv ∈ list[str] ← sys.argv
if len(argv) < 3:
    raise RuntimeError("give absolute Idriç and Ithon checkouts")
root ∈ Path ← Path(__file__).resolve().parent.parent
compiler_root ∈ Path ← Path(argv[1]).resolve()
ithon_root ∈ Path ← Path(argv[2]).resolve()
evidence ∈ Path ← root.joinpath("_", "evidence")
evidence.mkdir(parents=True, exist_ok=True)
environment ∈ dict[str, str] ← dict(os.environ)
environment["IDRIS2_PREFIX"] ← str(compiler_root.joinpath("_", "bootstrap-build"))
environment["IDRIS2_PATH"] ← str(compiler_root.joinpath("_", "libs", "prelude", "build", "ttc")) + ":" + str(compiler_root.joinpath("_", "libs", "base", "build", "ttc")) + ":" + str(root.joinpath("build", "ttc"))
environment["CHEZ"] ← str(compiler_root.joinpath("_", ".tools", "bin", "scheme"))
environment["LD_LIBRARY_PATH"] ← str(root.joinpath("_", "numeric"))
compiler ∈ str ← str(compiler_root.joinpath("build", "exec", "idris2"))
build_parent ∈ Path ← root.joinpath("build")

def run(name ∈ str, arguments ∈ list[str], expect_failure ∈ bool) → str:
    result ∈ object ← subprocess.run(arguments, cwd=str(root), env=environment, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    output ∈ str ← result.stdout
    status ∈ int ← result.returncode
    arguments_text ∈ str ← repr(arguments)
    evidence.joinpath(name + ".log").write_text(arguments_text + "\nexit=" + str(status) + "\n" + output)
    if (status == 0) == expect_failure:
        print(output)
        raise RuntimeError("FAIL " + name + " exit=" + str(status))
    print("PASS " + name)
    return output

head ∈ str ← run("compiler-pin", ["git", "-C", str(compiler_root), "rev-parse", "HEAD"], False)
compiler_head ∈ str ← head.strip()
if compiler_head != "0e8cfdd1106ebdeffd01b6c519880ea3afc7dc35":
    raise RuntimeError("compiler pin differs; qualify a changed dependency deliberately")
ithon_head ∈ str ← run("ithon-pin", ["git", "-C", str(ithon_root), "rev-parse", "HEAD"], False)
checked_ithon_head ∈ str ← ithon_head.strip()
if checked_ithon_head != "74ab6d6044b07b76a910978437a34a6b5ac6acda":
    raise RuntimeError("Ithon pin differs")
build_parent.mkdir(parents=True, exist_ok=True)
build_directory ∈ str ← tempfile.mkdtemp(prefix="qualification-", dir=str(build_parent))
build_root ∈ Path ← Path(build_directory)
evidence.joinpath("last-build-directory.txt").write_text(build_directory + "\n")
environment["IDRIS2_PATH"] ← str(compiler_root.joinpath("_", "libs", "prelude", "build", "ttc")) + ":" + str(compiler_root.joinpath("_", "libs", "base", "build", "ttc")) + ":" + str(build_root.joinpath("ttc"))
compiler_arguments ∈ list[str] ← [compiler, "--build-dir", str(build_root), "--output-dir", str(build_root.joinpath("exec"))]

def compile_command(arguments ∈ list[str]) → list[str]:
    combined ∈ list[str] ← compiler_arguments.copy()
    combined.extend(arguments)
    return combined

run("numeric-primitives", ["cc", "-std=c11", "-O2", "-fPIC", "-shared", "-Wall", "-Wextra", "-Werror", "-ffp-contract=off", str(root.joinpath("_", "numeric", "scalars.c")), "-lm", "-o", str(root.joinpath("_", "numeric", "libeye_numeric.so"))], False)
run("eye-modules", compile_command(["--build", "eye.ipkg"]), False)
run("host-test-build", compile_command(["--build", "eye-tests.ipkg"]), False)
run("host-tests", [str(build_root.joinpath("exec", "eye-host-tests"))], False)
run("native-boundary-host-build", compile_command(["--build", "eye-native-boundary.ipkg"]), False)
boundary_output ∈ str ← run("native-boundary-host-control", [str(build_root.joinpath("exec", "eye-native-boundary-host-control"))], False)
if boundary_output != "Y":
    raise RuntimeError("Eye native-boundary host control produced the wrong byte")
negative_root ∈ str ← "examples/autogenerated/observation-qualification/negative"
run("positive-fiber", compile_command(["--source-dir", negative_root, "--check", negative_root + "/PositiveFiber.idric"]), False)
negative_names ∈ list[str] ← ["UnrelatedFiber", "VectorAsCovector", "CovectorAsVector"]
for name in negative_names:
    diagnostic ∈ str ← run(name, compile_command(["--source-dir", negative_root, "--check", negative_root + "/" + name + ".idric"]), True)
    marker ∈ int ← diagnostic.find("Mismatch between:")
    if marker < 0:
        raise RuntimeError("negative fixture failed for the wrong reason: " + name)
oracle ∈ str ← str(root.joinpath("examples", "autogenerated", "observation-qualification", "symbolic-connections.pi"))
ithon ∈ str ← str(ithon_root.joinpath("ithon"))
run("symbolic-connections", [ithon, oracle], False)
bad_oracle ∈ str ← run("symbolic-negative-control", [ithon, oracle, "--corrupt-nil"], True)
bad_marker ∈ int ← bad_oracle.find("FAIL symbolic connection Nil component 0")
if bad_marker < 0:
    raise RuntimeError("symbolic control failed for the wrong reason")
emit_contract ∈ int ← argv.count("--emit-native-contract")
if emit_contract > 0:
    fixture ∈ Path ← build_root.joinpath("native-fixture")
    fixture.mkdir(parents=True)
    shutil.copytree(str(root.joinpath("src", "Eye")), str(fixture.joinpath("Eye")))
    shutil.copyfile(str(root.joinpath("examples", "autogenerated", "observation-qualification", "NativeBoundary.idric")), str(fixture.joinpath("NativeBoundary.idric")))
    run("native-contract-emission", [str(compiler_root.joinpath("edric")), "--emit-one-step", str(fixture.joinpath("NativeBoundary.idric")), "-o", str(build_root.joinpath("eye-native.one-step"))], False)
if len(argv) > 3 and argv[3] == "--render":
    output_directory ∈ Path ← root.joinpath("build", "demo")
    output_directory.mkdir(parents=True, exist_ok=True)
    run("demo-build", compile_command(["--build", "eye-demo.ipkg"]), False)
    run("demo-execution", [str(build_root.joinpath("exec", "eye-host-demo")), str(output_directory)], False)
print("PASS host qualification; direct native and Android acceptance are separate")
