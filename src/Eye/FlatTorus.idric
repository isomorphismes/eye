module Eye.FlatTorus

import Data.Text
import Eye.Geometry
import Eye.Models
import Eye.Visibility
import Eye.Quotient
import Eye.Trace

%unbound_implicits off

-- First concrete, exact-in-formula quotient example:
-- E³ / Z³ with canonical fundamental cube [0,1)^3. Traversal uses the
-- CLOSED cube's oriented boundary representatives: after x=0 moving left
-- crosses, x=1 moving left is valid and its next crossing is at x=0.
-- No epsilon is added and no travel is discarded at an identification.
-- Only face events exist in this demonstration; a populated scene must add
-- its OWN certified object events before claiming a complete event window.
-- This model has identity face differentials (translations), unlike Nil/Sol.

public export
data CubeAxis = AxisX | AxisY | AxisZ

public export
data CubeSide = MinimumFace | MaximumFace

public export
record CubeCrossing (scalar : Type) where
  constructor AcrossCubeFace
  crossing_length : scalar
  crossing_axis : CubeAxis
  crossing_side : CubeSide

public export
data NextCubeFace : Type → Type where
  OutsideCube : {scalar : Type} → NextCubeFace scalar
  InvalidCrossingArithmetic : {scalar : Type} → NextCubeFace scalar
  NoPositiveCrossing : {scalar : Type} → NextCubeFace scalar
  FirstCubeFace : {scalar : Type} → (CubeCrossing scalar) → NextCubeFace scalar
  SimultaneousCubeFaces : {scalar : Type} → (List (CubeCrossing scalar)) → NextCubeFace scalar

private
data AxisCrossing : Type → Type where
  StationaryAxis : {scalar : Type} → AxisCrossing scalar
  InvalidAxisArithmetic : {scalar : Type} → AxisCrossing scalar
  CrossingOnAxis : {scalar : Type} → (CubeCrossing scalar) → AxisCrossing scalar

private
valid_coordinate : {scalar : Type} → ScalarOperations scalar → scalar → Bool
valid_coordinate arithmetic coordinate =
  let zero = scalar_zero arithmetic
      one = scalar_one arithmetic
  in scalar_finite arithmetic coordinate &&
     not (scalar_less arithmetic coordinate zero) &&
     scalar_less arithmetic coordinate one

public export
inside_unit_cube : {scalar : Type} →
                   ScalarOperations scalar → Point Euclidean3 scalar → Bool
inside_unit_cube arithmetic (Located Cartesian (XYZ x y z)) =
  valid_coordinate arithmetic x &&
  valid_coordinate arithmetic y &&
  valid_coordinate arithmetic z

private
closed_coordinate : {scalar : Type} → ScalarOperations scalar → scalar → Bool
closed_coordinate arithmetic value =
  scalar_finite arithmetic value &&
  not (scalar_less arithmetic value (scalar_zero arithmetic)) &&
  not (scalar_less arithmetic (scalar_one arithmetic) value)

export
in_closed_cube : {scalar : Type} → ScalarOperations scalar →
                 Point Euclidean3 scalar → Bool
in_closed_cube arithmetic (Located Cartesian (XYZ x y z)) =
  closed_coordinate arithmetic x && closed_coordinate arithmetic y &&
  closed_coordinate arithmetic z

private
axis_crossing : {scalar : Type} →
                ScalarOperations scalar → CubeAxis →
                scalar → scalar → AxisCrossing scalar
axis_crossing arithmetic axis coordinate direction =
  let zero = scalar_zero arithmetic
      one = scalar_one arithmetic
      positive = scalar_less arithmetic zero direction
      negative = scalar_less arithmetic direction zero
  in if not (scalar_finite arithmetic direction)
       then InvalidAxisArithmetic
       else if positive
         then let length = scalar_divide arithmetic
                             (subtract_scalars arithmetic one coordinate) direction
              in if scalar_finite arithmetic length &&
                    not (scalar_less arithmetic length zero)
                   then CrossingOnAxis (AcrossCubeFace length axis MaximumFace)
                   else InvalidAxisArithmetic
         else if negative
           then let length = scalar_divide arithmetic
                               (subtract_scalars arithmetic zero coordinate) direction
                in if scalar_finite arithmetic length &&
                      not (scalar_less arithmetic length zero)
                     then CrossingOnAxis (AcrossCubeFace length axis MinimumFace)
                     else InvalidAxisArithmetic
           else StationaryAxis

private
combine_crossings : {scalar : Type} → ScalarOperations scalar →
                    NextCubeFace scalar → CubeCrossing scalar → NextCubeFace scalar
combine_crossings arithmetic NoPositiveCrossing candidate = FirstCubeFace candidate
combine_crossings arithmetic OutsideCube candidate = OutsideCube
combine_crossings arithmetic InvalidCrossingArithmetic candidate = InvalidCrossingArithmetic
combine_crossings arithmetic (FirstCubeFace selected) candidate =
  let earlier = crossing_length selected
      later = crossing_length candidate
  in if scalar_less arithmetic later earlier
       then FirstCubeFace candidate
       else if scalar_less arithmetic earlier later
         then FirstCubeFace selected
         else SimultaneousCubeFaces [selected, candidate]
combine_crossings arithmetic (SimultaneousCubeFaces []) candidate =
  InvalidCrossingArithmetic
combine_crossings arithmetic (SimultaneousCubeFaces (first :: rest)) candidate =
  if scalar_less arithmetic (crossing_length candidate) (crossing_length first)
    then FirstCubeFace candidate
    else if scalar_less arithmetic (crossing_length first) (crossing_length candidate)
      then SimultaneousCubeFaces (first :: rest)
      else SimultaneousCubeFaces (first :: rest ++ [candidate])

private
include_crossing : {scalar : Type} → ScalarOperations scalar →
                   NextCubeFace scalar →
                   AxisCrossing scalar → NextCubeFace scalar
include_crossing arithmetic selected StationaryAxis = selected
include_crossing arithmetic selected InvalidAxisArithmetic = InvalidCrossingArithmetic
include_crossing arithmetic selected (CrossingOnAxis candidate) =
  combine_crossings arithmetic selected candidate

public export
next_cube_face : {scalar : Type} → ScalarOperations scalar →
                 RayState Euclidean3 scalar → NextCubeFace scalar
next_cube_face arithmetic (RayAt point (AtPoint (XYZ vx vy vz))) =
  if not (coordinate_values_finite arithmetic (coordinates_at point) &&
          coordinate_values_finite arithmetic (XYZ vx vy vz))
    then InvalidCrossingArithmetic
    else if not (in_closed_cube arithmetic point) then OutsideCube
    else case coordinates_at point of
      XYZ x y z =>
        let by_x = axis_crossing arithmetic AxisX x vx
            by_y = axis_crossing arithmetic AxisY y vy
            by_z = axis_crossing arithmetic AxisZ z vz
            initial = include_crossing arithmetic NoPositiveCrossing by_x
            after_y = include_crossing arithmetic initial by_y
        in include_crossing arithmetic after_y by_z

public export
face_label : {scalar : Type} → CubeCrossing scalar → Number
face_label (AcrossCubeFace _ AxisX MaximumFace) = 0
face_label (AcrossCubeFace _ AxisX MinimumFace) = 1
face_label (AcrossCubeFace _ AxisY MaximumFace) = 2
face_label (AcrossCubeFace _ AxisY MinimumFace) = 3
face_label (AcrossCubeFace _ AxisZ MaximumFace) = 4
face_label (AcrossCubeFace _ AxisZ MinimumFace) = 5

private
translate_point : {scalar : Type} → ScalarOperations scalar →
                  Coordinates scalar → Point Euclidean3 scalar →
                  Point Euclidean3 scalar
translate_point arithmetic delta (Located Cartesian position) =
  Located Cartesian (add_coordinates arithmetic position delta)

private
translate_tangent : {scalar : Type} → (arithmetic : ScalarOperations scalar) →
                    (delta : Coordinates scalar) →
                    (point : Point Euclidean3 scalar) →
                    Tangent point → Tangent (translate_point arithmetic delta point)
translate_tangent arithmetic delta point (AtPoint vector) = AtPoint vector

private
translation : {scalar : Type} → ScalarOperations scalar →
              Text → Coordinates scalar → DeckAction Euclidean3 scalar
translation arithmetic label delta =
  SuppliedDeckAction label
    (translate_point arithmetic delta)
    (translate_tangent arithmetic delta)

public export
unit_cube_deck : {scalar : Type} → ScalarOperations scalar →
                 Number → Maybe (DeckAction Euclidean3 scalar)
unit_cube_deck arithmetic label =
  let zero = scalar_zero arithmetic
      one = scalar_one arithmetic
      minus_one = scalar_negate arithmetic one
  in if label ≟ 0
       then Just (translation arithmetic "x−1" (XYZ minus_one zero zero))
       else if label ≟ 1
         then Just (translation arithmetic "x+1" (XYZ one zero zero))
         else if label ≟ 2
           then Just (translation arithmetic "y−1" (XYZ zero minus_one zero))
           else if label ≟ 3
             then Just (translation arithmetic "y+1" (XYZ zero one zero))
             else if label ≟ 4
               then Just (translation arithmetic "z−1" (XYZ zero zero minus_one))
               else if label ≟ 5
                 then Just (translation arithmetic "z+1" (XYZ zero zero one))
                 else Nothing

-- Exact Euclidean flow, including identity parallel transport, used as an
-- independent oracle for the general RK4 solver. No trigonometry is needed.
public export
straight_ray_and_frame : {scalar : Type} → ScalarOperations scalar →
                         scalar → FramedRay Euclidean3 scalar →
                         FramedRay Euclidean3 scalar
straight_ray_and_frame arithmetic length framed =
  let previous = frame_location framed
      displacement = scale_coordinates arithmetic length
                       (tangent_components (frame_velocity framed))
      position = add_coordinates arithmetic (coordinates_at previous) displacement
  in RayWithFrame (Located Cartesian position)
       (AtPoint (tangent_components (frame_velocity framed)))
       (AtPoint (tangent_components (frame_right framed)))
       (AtPoint (tangent_components (frame_up framed)))
       (AtPoint (tangent_components (frame_forward framed)))

private
face_covector : {scalar : Type} → ScalarOperations scalar →
                (point : Point Euclidean3 scalar) →
                CubeCrossing scalar → Cotangent point
face_covector arithmetic point crossing =
  let zero = scalar_zero arithmetic
      one = scalar_one arithmetic
      sign = case crossing_side crossing of
        MinimumFace => scalar_negate arithmetic one
        MaximumFace => one
  in case crossing_axis crossing of
    AxisX => CovectorAt (XYZ sign zero zero)
    AxisY => CovectorAt (XYZ zero sign zero)
    AxisZ => CovectorAt (XYZ zero zero sign)

private
cube_hit : {scalar : Type} → ScalarOperations scalar →
           CubeCrossing scalar → FramedRay Euclidean3 scalar →
           GeodesicHit Euclidean3 scalar
cube_hit arithmetic crossing starting =
  let length = crossing_length crossing
      reached = straight_ray_and_frame arithmetic length starting
  in case reached of
    RayWithFrame point direction right up forward =>
      HitAlongRay length point direction (face_covector arithmetic point crossing)
        right up forward

-- Certify only an EMPTY cube's face events on [0,horizon]. Simultaneous
-- torus translations are one event; their commutation is specific to Z³.
public export
empty_cube_window : {scalar : Type} → ScalarOperations scalar →
                    scalar → FramedRay Euclidean3 scalar →
                    EventWindow Euclidean3 scalar
empty_cube_window arithmetic horizon framed =
  let zero = scalar_zero arithmetic
      position = frame_location framed
      velocity = frame_velocity framed
  in if not (scalar_finite arithmetic horizon &&
             scalar_less arithmetic zero horizon)
       then UnknownBefore horizon
       else case next_cube_face arithmetic (RayAt (frame_location framed) (frame_velocity framed)) of
         OutsideCube => InvalidWindow InvalidEventArithmetic
         InvalidCrossingArithmetic => InvalidWindow InvalidEventArithmetic
         NoPositiveCrossing => CompleteBefore horizon []
         SimultaneousCubeFaces [] => UnknownBefore horizon
         SimultaneousCubeFaces (first :: rest) =>
           let length = crossing_length first
           in if scalar_less arithmetic horizon length
                then CompleteBefore horizon []
                else CompleteBefore horizon
                  [FundamentalFaces length (map face_label (first :: rest))
                    (straight_ray_and_frame arithmetic length framed)]
         FirstCubeFace crossing =>
           let length = crossing_length crossing
           in if not (scalar_less arithmetic horizon length)
                then CompleteBefore horizon
                  [FundamentalFace (face_label crossing)
                    (cube_hit arithmetic crossing framed)]
                else CompleteBefore horizon []

private
apply_torus_faces : {scalar : Type} → ScalarOperations scalar →
                    List Number → LiftedRay Euclidean3 scalar →
                    Maybe (LiftedRay Euclidean3 scalar)
apply_torus_faces arithmetic [] lifted = Just lifted
apply_torus_faces arithmetic (label :: rest) lifted =
  case unit_cube_deck arithmetic label of
    Nothing => Nothing
    Just action => apply_torus_faces arithmetic rest (through_paired_face action lifted)

private
resolve_torus_faces : {scalar : Type} → ScalarOperations scalar →
                      LiftedRay Euclidean3 scalar → TraceResult Euclidean3 scalar →
                      TraceResult Euclidean3 scalar
resolve_torus_faces arithmetic original (NeedsFaceBatch length labels reached) =
  case apply_torus_faces arithmetic labels
         (OnUniversalCover reached (crossed_deck_generators original)) of
    Nothing => NeedRefinement length
    Just finished => CrossedPairedFace finished
resolve_torus_faces arithmetic original result = result

-- One actual end-to-end high-level quotient step: detect next cube face,
-- construct the exact hit-frame, apply its translation differential, and
-- retain its symbolic deck word. Scene objects are deliberately absent.
public export
trace_empty_flat_torus_window : {scalar : Type} →
                                ScalarOperations scalar →
                                scalar → scalar → LiftedRay Euclidean3 scalar →
                                TraceResult Euclidean3 scalar
trace_empty_flat_torus_window arithmetic horizon tolerance lifted =
  resolve_torus_faces arithmetic lifted $ trace_one_window
    (model_for Euclidean3 arithmetic)
    tolerance
    (unit_cube_deck arithmetic)
    lifted
    (empty_cube_window arithmetic horizon (ray_and_frame lifted))

-- This constructor is specific to the translation group Z³. General deck
-- actions do not inherit its simultaneous-event resolution rule.
export
torus_services : {scalar : Type} → ScalarOperations scalar →
                 (scalar → LiftedRay Euclidean3 scalar → EventWindow Euclidean3 scalar) →
                 TraceServices Euclidean3 scalar
torus_services arithmetic scene_events =
  TraceWith
    (\horizon, lifted => combine_windows arithmetic
      (empty_cube_window arithmetic horizon (ray_and_frame lifted))
      (scene_events horizon lifted))
    (unit_cube_deck arithmetic) (apply_torus_faces arithmetic) (\_ => Nothing)
