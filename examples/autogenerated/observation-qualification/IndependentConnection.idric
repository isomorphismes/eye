module IndependentConnection

import Eye.Geometry
import Eye.Models
import Eye.Geodesic
import HostScalars

-- Independent coordinate metric matrices and the Levi-Civita formula.
-- No implemented christoffel contraction is used to derive the reference.
-- This is numerical central differentiation, not symbolic proof.
private
data CoordinateAxis = First | Second | Third

private
axes : List CoordinateAxis
axes = [First, Second, Third]

private
component : CoordinateAxis → Coordinates Double → Double
component First (XYZ x _ _) = x
component Second (XYZ _ y _) = y
component Third (XYZ _ _ z) = z

private
entry : CoordinateAxis → CoordinateAxis → Coordinates (Coordinates Double) → Double
entry row column matrix = component column (component_row row matrix)
  where
    component_row : CoordinateAxis → Coordinates (Coordinates Double) → Coordinates Double
    component_row First (XYZ row _ _) = row
    component_row Second (XYZ _ row _) = row
    component_row Third (XYZ _ _ row) = row

private
diagonal : Double → Double → Double → Coordinates (Coordinates Double)
diagonal x y z = XYZ (XYZ x 0.0 0.0) (XYZ 0.0 y 0.0) (XYZ 0.0 0.0 z)

private
metric_matrix : ThurstonGeometry → Coordinates Double → Coordinates (Coordinates Double)
metric_matrix Euclidean3 _ = diagonal 1.0 1.0 1.0
metric_matrix Spherical3 (XYZ x y z) =
  let denominator = 1.0 + x × x + y × y + z × z
      factor = 4.0 ÷ (denominator × denominator)
  in diagonal factor factor factor
metric_matrix Hyperbolic3 (XYZ _ _ z) =
  let factor = 1.0 ÷ (z × z) in diagonal factor factor factor
metric_matrix Sphere2TimesLine (XYZ x y _) =
  let denominator = 1.0 + x × x + y × y
      factor = 4.0 ÷ (denominator × denominator)
  in diagonal factor factor 1.0
metric_matrix Hyperbolic2TimesLine (XYZ _ y _) =
  let factor = 1.0 ÷ (y × y) in diagonal factor factor 1.0
metric_matrix Nil3 (XYZ x _ _) =
  XYZ (XYZ 1.0 0.0 0.0) (XYZ 0.0 (1.0 + x × x) (-x)) (XYZ 0.0 (-x) 1.0)
metric_matrix Sol3 (XYZ _ _ z) = diagonal (exp (2.0 × z)) (exp (-2.0 × z)) 1.0
metric_matrix UniversalCoverSL2 (XYZ _ y _) =
  XYZ (XYZ (2.0 ÷ (y × y)) 0.0 (1.0 ÷ y))
      (XYZ 0.0 (1.0 ÷ (y × y)) 0.0) (XYZ (1.0 ÷ y) 0.0 1.0)

private
inverse : Coordinates (Coordinates Double) → Coordinates (Coordinates Double)
inverse matrix =
  let a = entry First First matrix
      b = entry First Second matrix
      c = entry First Third matrix
      d = entry Second First matrix
      e = entry Second Second matrix
      f = entry Second Third matrix
      g = entry Third First matrix
      h = entry Third Second matrix
      i = entry Third Third matrix
      determinant = a × (e × i - f × h) - b × (d × i - f × g) + c × (d × h - e × g)
  in XYZ
    (XYZ ((e × i - f × h) ÷ determinant) ((c × h - b × i) ÷ determinant) ((b × f - c × e) ÷ determinant))
    (XYZ ((f × g - d × i) ÷ determinant) ((a × i - c × g) ÷ determinant) ((c × d - a × f) ÷ determinant))
    (XYZ ((d × h - e × g) ÷ determinant) ((b × g - a × h) ÷ determinant) ((a × e - b × d) ÷ determinant))

private
displace : CoordinateAxis → Double → Coordinates Double → Coordinates Double
displace First amount (XYZ x y z) = XYZ (x + amount) y z
displace Second amount (XYZ x y z) = XYZ x (y + amount) z
displace Third amount (XYZ x y z) = XYZ x y (z + amount)

private
metric_derivative : ThurstonGeometry → Coordinates Double →
                    CoordinateAxis → CoordinateAxis → CoordinateAxis → Double
metric_derivative geometry position direction row column =
  let spacing = 1.0e-5
      plus = metric_matrix geometry (displace direction spacing position)
      minus = metric_matrix geometry (displace direction (-spacing) position)
  in (entry row column plus - entry row column minus) ÷ (2.0 × spacing)

private
sum_axes : (CoordinateAxis → Double) → Double
sum_axes expression = foldl (\accumulated, axis ⇒ accumulated + expression axis) 0.0 axes

private
reference_component : ThurstonGeometry → Coordinates Double →
                      Coordinates Double → Coordinates Double → CoordinateAxis → Double
reference_component geometry position left right output =
  let inverse_metric = inverse (metric_matrix geometry position)
      derivative = metric_derivative geometry position
  in 0.5 × sum_axes (\contracted ⇒
    entry output contracted inverse_metric × sum_axes (\first ⇒ sum_axes (\second ⇒
      (derivative first contracted second + derivative second contracted first -
       derivative contracted first second) × component first left × component second right)))

private
basis : CoordinateAxis → Coordinates Double
basis First = XYZ 1.0 0.0 0.0
basis Second = XYZ 0.0 1.0 0.0
basis Third = XYZ 0.0 0.0 1.0

private
all_axes : (CoordinateAxis → Bool) → Bool
all_axes predicate = foldl (\passed, axis ⇒ passed && predicate axis) True axes

private
reference_gamma : ThurstonGeometry → Coordinates Double → Coordinates Double → Coordinates Double
reference_gamma geometry position velocity =
  XYZ (reference_component geometry position velocity velocity First)
      (reference_component geometry position velocity velocity Second)
      (reference_component geometry position velocity velocity Third)

private
add_scaled : Coordinates Double → Double → Coordinates Double → Coordinates Double
add_scaled position amount velocity =
  XYZ (component First position + amount × component First velocity)
      (component Second position + amount × component Second velocity)
      (component Third position + amount × component Third velocity)

private
reference_midpoint : Number → ThurstonGeometry → Double →
                     Coordinates Double → Coordinates Double → (Coordinates Double, Coordinates Double)
reference_midpoint Z geometry step position velocity = (position, velocity)
reference_midpoint (S later) geometry step position velocity =
  let acceleration = reference_gamma geometry position velocity
      middle_position = add_scaled position (step ÷ 2.0) velocity
      middle_velocity = add_scaled velocity (negate step ÷ 2.0) acceleration
      middle_acceleration = reference_gamma geometry middle_position middle_velocity
      next_position = add_scaled position step middle_velocity
      next_velocity = add_scaled velocity (negate step) middle_acceleration
  in reference_midpoint later geometry step next_position next_velocity

private
actual_steps : {geometry : ThurstonGeometry} → Number →
               MetricConnection geometry Float32 → FramedRay geometry Float32 → Maybe (FramedRay geometry Float32)
actual_steps Z model ray = Just ray
actual_steps (S later) model ray = case advance_checked model 0.025 0.00002 ray of
  StepRefused _ ⇒ Nothing
  StepAdvanced next _ ⇒ actual_steps later model next

private
component32 : CoordinateAxis → Coordinates Float32 → Float32
component32 First (XYZ x _ _) = x
component32 Second (XYZ _ y _) = y
component32 Third (XYZ _ _ z) = z

export
independent_sl2_trajectory : Bool
independent_sl2_trajectory =
  let initial_position = XYZ 0.0 1.0 0.0
      initial_velocity = XYZ 1.0 0.0 (-1.0)
      (expected_position, expected_velocity) = reference_midpoint 1000 UniversalCoverSL2 0.00025 initial_position initial_velocity
      initial = RayWithFrame (Located SL2LiftedHalfPlane (the (Coordinates Float32) (XYZ 0.0 1.0 0.0)))
        (AtPoint (XYZ 1.0 0.0 (-1.0))) (AtPoint (XYZ 1.0 0.0 (-1.0)))
        (AtPoint (XYZ 0.0 1.0 0.0)) (AtPoint (XYZ 0.0 0.0 1.0))
      error : Coordinates Float32 → Coordinates Double → Bool
      error = \actual, expected ⇒ all_axes (\axis ⇒ abs (to_reference (component32 axis actual) - component axis expected) < 0.00005)
  in case actual_steps 10 (model_for UniversalCoverSL2 host_numbers) initial of
    Nothing ⇒ False
    Just finished ⇒ error (coordinates_at (frame_location finished)) expected_position &&
      error (tangent_components (frame_velocity finished)) expected_velocity

export
independent_connection_check : (geometry : ThurstonGeometry) →
                              Chart geometry → Coordinates Double → Bool
independent_connection_check geometry chart position =
  let point = Located chart position
      model = model_for geometry host_numbers
      expected_metric = metric_matrix geometry position
      stored_position = case position of XYZ x y z ⇒ XYZ (from_reference x) (from_reference y) (from_reference z)
      stored_point = Located chart stored_position
  in all_axes (\first ⇒ all_axes (\second ⇒
    let left = basis first
        right = basis second
        stored_left = case left of XYZ x y z ⇒ XYZ (from_reference x) (from_reference y) (from_reference z)
        stored_right = case right of XYZ x y z ⇒ XYZ (from_reference x) (from_reference y) (from_reference z)
        actual_values = christoffel_at model stored_point (AtPoint stored_left) (AtPoint stored_right)
        actual = case actual_values of XYZ x y z ⇒ XYZ (to_reference x) (to_reference y) (to_reference z)
        metric_value = to_reference (metric_at model stored_point (AtPoint stored_left) (AtPoint stored_right))
    in abs (metric_value - entry first second expected_metric) < 2.0e-6 &&
       all_axes (\output ⇒
         let value = component output actual
             reference = reference_component geometry position left right output
         in finite_binary64 value && finite_binary64 reference && abs (value - reference) < 2.0e-6)))
